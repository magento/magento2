<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework/Module/etc/system_file.xsd">
    <system>
        <tab id="diepxuan" translate="label" sortOrder="100">
            <label>Diepxuan SyncCRM</label>
        </tab>
        <section id="synccrm" translate="label" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>SyncCRM Settings</label>
            <tab>diepxuan</tab>
            <resource>Diepxuan_SyncCRM::config</resource>

            <group id="api_settings" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>API Settings</label>

                <field id="api_token" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Access Token</label>
                    <validate>required-entry</validate>
                    <canRestore>1</canRestore>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
