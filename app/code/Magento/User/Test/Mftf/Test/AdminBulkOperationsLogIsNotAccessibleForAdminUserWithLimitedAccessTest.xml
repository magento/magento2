<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminBulkOperationsLogIsNotAccessibleForAdminUserWithLimitedAccessTest">
        <annotations>
            <stories value="Asynchronous Operations"/>
            <title value="'Your Bulk Operations Log' isn't accessible if admin user doesn't have privileges for it"/>
            <description value="An admin user can view his own bulk operations only in a separate grid if his role has Bulk Operations resource."/>
            <severity value="CRITICAL"/>
            <testCaseId value="MC-13245"/>
            <group value="AsynchronousOperations"/>
            <group value="User"/>
            <group value="pr_exclude"/>
            <group value="cloud"/>
        </annotations>

        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <actionGroup ref="AdminOpenCreateRolePageActionGroup" stepKey="restrictedAdminRoleMainWebsite"/>
            <actionGroup ref="AdminStartCreateUserRoleActionGroup" stepKey="startCreateUserRole">
                <argument name="roleName" value="{{adminProductInWebsiteRole.rolename}}"/>
                <argument name="userPassword" value="{{_CREDS.magento/MAGENTO_ADMIN_PASSWORD}}"/>
                <argument name="resourceAccess" value="Custom"/>
                <argument name="storeName" value="{{_defaultWebsite.name}}"/>
            </actionGroup>
            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="dashboardAccess">
                <argument name="resourceId" value="Magento_Backend::dashboard_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="analyticsApiAccess">
                <argument name="resourceId" value="Magento_Analytics::analytics_api_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="salesOperationAccess">
                <argument name="resourceId" value="Magento_Sales::sales_operation_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="catalogAccess">
                <argument name="resourceId" value="Magento_Catalog::catalog_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="customerAccess">
                <argument name="resourceId" value="Magento_Customer::customer_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="cartAccess">
                <argument name="resourceId" value="Magento_Cart::cart_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="myaccountAccess">
                <argument name="resourceId" value="Magento_Backend::myaccount_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="marketingAccess">
                <argument name="resourceId" value="Magento_Backend::marketing_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="contentAccess">
                <argument name="resourceId" value="Magento_Backend::content_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="reportAccess">
                <argument name="resourceId" value="Magento_Reports::report_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="convertAccess">
                <argument name="resourceId" value="Magento_Backend::convert_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="extensionsAccess">
                <argument name="resourceId" value="Magento_Backend::extensions_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="integrationExtensionsAccess">
                <argument name="resourceId" value="Magento_Integration::integrations_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="cacheAccess">
                <argument name="resourceId" value="Magento_Backend::cache_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="systemOtherSettingsAccess">
                <argument name="resourceId" value="Magento_Backend::system_other_settings_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="globalSearchAccess">
                <argument name="resourceId" value="Magento_Backend::global_search_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="backupAccess">
                <argument name="resourceId" value="Magento_Backup::backup_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="indexAccess">
                <argument name="resourceId" value="Magento_Indexer::index_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="changeModeAccess">
                <argument name="resourceId" value="Magento_Indexer::changeMode_anchor"/>
            </actionGroup>

            <actionGroup ref="AdminSelectUserRoleResourceActionGroup" stepKey="userAclAccess">
                <argument name="resourceId" value="Magento_User::acl_anchor"/>
            </actionGroup>
            <actionGroup ref="AdminSaveUserRoleActionGroup" stepKey="saveRole"/>
        </before>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logout"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="LoginAdmin"/>

            <actionGroup ref="AdminDeleteCustomUserActionGroup" stepKey="deleteNewUser">
                <argument name="user" value="NewAdminUser"/>
            </actionGroup>
            <actionGroup ref="AdminDeleteUserRoleActionGroup" stepKey="deleteRestrictedRole">
                <argument name="roleName" value="{{adminProductInWebsiteRole.rolename}}"/>
            </actionGroup>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logout2"/>
        <after>

        </after>
        <actionGroup ref="AdminCreateUserWithApiRoleActionGroup" stepKey="adminCreateUser">
            <argument name="user" value="NewAdminUser"/>
            <argument name="role" value="adminProductInWebsiteRole"/>
        </actionGroup>
        <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAdmin"/>

        <actionGroup ref="AdminLoginActionGroup" stepKey="LoginAsUser">
            <argument name="username" value="{{NewAdminUser.username}}"/>
            <argument name="password" value="{{NewAdminUser.password}}"/>
        </actionGroup>

        <click selector="{{AdminMenuSection.menuItem('magento-backend-system')}}" stepKey="clickSystem"/>
        <dontSeeElement selector="{{AdminMenuSection.menuItem('magento-logging-system-magento-logging-bulk-operations')}}" stepKey="dontSeeBulkOperations"/>
        <click selector="{{AdminMenuSection.menuItem('magento-backend-system')}}" stepKey="clickSystem1"/>

        <waitForElementVisible selector="{{AdminSystemMessagesSection.systemMessagesDropdown}}" stepKey="waitMessagesDropdownAppears"/>
        <conditionalClick selector="{{AdminSystemMessagesSection.systemMessagesDropdown}}" dependentSelector="{{AdminSystemMessagesSection.messagesBlock}}" visible="false" stepKey="openMessagesBlockIfCollapsed"/>

        <dontSeeElement selector="{{AdminSystemMessagesSection.actionMessageLog('Dismiss All Completed Tasks')}}" stepKey="dontSeeDismissAllCompleted"/>
        <dontSeeElement selector="{{AdminSystemMessagesSection.actionMessageLog('Bulk Actions Log')}}" stepKey="dontSeeTaskYourBulkOperationsLog"/>

        <amOnPage url="{{AdminBulkActionsLogIndexPage.url}}" stepKey="OnBulkPage"/>
        <waitForPageLoad stepKey="waitForPageLoad"/>

        <see userInput="Sorry, you need permissions to view this content." selector="{{AdminMessagesSection.accessDenied}}" stepKey="seeAccessDenied"/>
    </test>
</tests>
