<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="StorefrontBundleOldPriceExcludingTaxTest">
        <annotations>
            <features value="Bundle"/>
            <stories value="Old price with catalog prices including tax and display excluding tax"/>
            <title value="Old price of a customized bundle stays excluding tax"/>
            <description value="Old price of a customized bundle stays excluding tax"/>
            <severity value="MAJOR"/>
            <group value="bundle"/>
        </annotations>
        <before>
            <magentoCLI command="config:set tax/calculation/based_on origin" stepKey="setTaxBasedOnOrigin"/>
            <magentoCLI command="config:set tax/calculation/price_includes_tax 1" stepKey="setCatalogPricesIncludingTax"/>
            <magentoCLI command="config:set tax/display/type 1" stepKey="setDisplayExcludingTax"/>
            <createData entity="SimpleTaxRule" stepKey="createTaxRule"/>
            <createData entity="SimpleProduct2" stepKey="createSimple1"/>
            <createData entity="SimpleProduct2" stepKey="createSimple2"/>
            <createData entity="ApiFixedBundleProduct" stepKey="createBundle">
                <field key="price">108.25</field>
            </createData>
            <createData entity="specialProductPrice" stepKey="addSpecial">
                <requiredEntity createDataKey="createBundle"/>
                <field key="price">60</field>
            </createData>
            <createData entity="RadioButtonsOption" stepKey="createOption">
                <requiredEntity createDataKey="createBundle"/>
            </createData>
            <createData entity="ApiBundleLinkFixed" stepKey="link1">
                <requiredEntity createDataKey="createBundle"/>
                <requiredEntity createDataKey="createOption"/>
                <requiredEntity createDataKey="createSimple1"/>
                <field key="price">21.65</field>
                <field key="is_default">0</field>
            </createData>
            <createData entity="ApiBundleLinkFixed" stepKey="link2">
                <requiredEntity createDataKey="createBundle"/>
                <requiredEntity createDataKey="createOption"/>
                <requiredEntity createDataKey="createSimple2"/>
                <field key="price">43.30</field>
                <field key="is_default">0</field>
            </createData>
            <actionGroup ref="CliIndexerReindexActionGroup" stepKey="reindex">
                <argument name="indices" value=""/>
            </actionGroup>
            <actionGroup ref="CliCacheCleanActionGroup" stepKey="cleanCache">
                <argument name="tags" value="config full_page"/>
            </actionGroup>
        </before>
        <after>
            <deleteData createDataKey="createBundle" stepKey="deleteBundle"/>
            <deleteData createDataKey="createSimple1" stepKey="deleteSimple1"/>
            <deleteData createDataKey="createSimple2" stepKey="deleteSimple2"/>
            <deleteData createDataKey="createTaxRule" stepKey="deleteTaxRule"/>
            <magentoCLI command="config:set tax/calculation/based_on shipping" stepKey="resetTaxBasedOn"/>
            <magentoCLI command="config:set tax/calculation/price_includes_tax 0" stepKey="resetCatalogPrices"/>
            <magentoCLI command="config:set tax/display/type 1" stepKey="resetDisplay"/>
            <actionGroup ref="CliCacheCleanActionGroup" stepKey="cleanCacheAfter">
                <argument name="tags" value="config full_page"/>
            </actionGroup>
        </after>
        <actionGroup ref="StorefrontOpenProductPageActionGroup" stepKey="openProductPage">
            <argument name="productUrl" value="$$createBundle.custom_attributes[url_key]$$"/>
        </actionGroup>
        <click selector="{{StorefrontBundledSection.customizeProduct}}" stepKey="customize"/>
        <waitForElementVisible selector="#bundleSummary [data-price-type='basePrice'] .price" stepKey="waitConfigured"/>
        <click selector="{{StorefrontBundledSection.nthBundledOption('1','1')}}" stepKey="selectLink1"/>
        <waitForText selector="#bundleSummary [data-price-type='basePrice'] .price" userInput="$72.00" stepKey="waitPriceUpdate1"/>
        <grabTextFrom selector=".product-info-main .old-price .price" stepKey="grabOldLink1"/>
        <assertEquals stepKey="assertOldLink1">
            <actualResult type="const">$grabOldLink1</actualResult>
            <expectedResult type="string">$120.00</expectedResult>
        </assertEquals>
        <grabTextFrom selector="#bundleSummary [data-price-type='basePrice'] .price" stepKey="grabFinalLink1"/>
        <assertEquals stepKey="assertFinalLink1">
            <actualResult type="const">$grabFinalLink1</actualResult>
            <expectedResult type="string">$72.00</expectedResult>
        </assertEquals>
        <click selector="{{StorefrontBundledSection.nthBundledOption('1','2')}}" stepKey="selectLink2"/>
        <waitForText selector="#bundleSummary [data-price-type='basePrice'] .price" userInput="$84.00" stepKey="waitPriceUpdate2"/>
        <grabTextFrom selector=".product-info-main .old-price .price" stepKey="grabOldLink2"/>
        <assertEquals stepKey="assertOldLink2">
            <actualResult type="const">$grabOldLink2</actualResult>
            <expectedResult type="string">$120.00</expectedResult>
        </assertEquals>
        <grabTextFrom selector="#bundleSummary [data-price-type='basePrice'] .price" stepKey="grabFinalLink2"/>
        <assertEquals stepKey="assertFinalLink2">
            <actualResult type="const">$grabFinalLink2</actualResult>
            <expectedResult type="string">$84.00</expectedResult>
        </assertEquals>
    </test>
</tests>
