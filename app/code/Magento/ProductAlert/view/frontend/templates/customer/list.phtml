                    <?php endif; ?>
                    <div class="actions-toolbar">
                        <div class="secondary">
                            <a class="action unsubscribe-all"
                               href="<?= $escaper->escapeUrl($block->getUnsubscribeAllPriceUrl()) ?>">
                                <span><?= $escaper->escapeHtml(__('Unsubscribe from all price alerts')) ?></span>
                            </a>
                        </div>
                    </div>
                <?php else: ?>
                    <div class="message info empty">
                        <span><?= $escaper->escapeHtml(__('You have no price alert subscriptions.')) ?></span>
                    </div>
                <?php endif; ?>
            </div>
        </div>
    <?php endif; ?>

