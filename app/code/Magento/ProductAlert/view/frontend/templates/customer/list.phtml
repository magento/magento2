?>
<?php if (!$block->isPriceAlertAllowed() && !$block->isStockAlertAllowed()): ?>
    <div class="message info empty">
        <span><?= $escaper->escapeHtml(__('Product alerts are currently unavailable.')) ?></span>
    </div>
<?php else: ?>

    <?php if ($block->isPriceAlertAllowed()): ?>
        <div class="block block-product-alert-price" id="product-alert-price-section">
            <div class="block-title">
                <strong><?= $escaper->escapeHtml(__('Price Alerts')) ?></strong>
            </div>
            <div class="block-content">
                <?php if ($block->hasPriceAlerts()): ?>
                    <div class="table-wrapper product-alerts-price">
                        <table class="data table table-product-alerts-price" id="my-price-alerts-table">
                            <caption class="table-caption"><?= $escaper->escapeHtml(__('Price Alerts')) ?></caption>
                            <thead>
                            <tr>
                                <th scope="col" class="col date"><?= $escaper->escapeHtml(__('Created')) ?></th>
                                <th scope="col" class="col item"><?= $escaper->escapeHtml(__('Product Name')) ?></th>
                                <th scope="col" class="col price"><?= $escaper->escapeHtml(__('Subscribed Price')) ?></th>
                                <th scope="col" class="col actions"><?= $escaper->escapeHtml(__('Action')) ?></th>
                            </tr>
                            </thead>
                            <tbody>
                            <?php foreach ($block->getPriceAlerts() as $alert): ?>
                                <?php $product = $block->getProduct($alert); ?>
                                <tr>
                                    <td data-th="<?= $escaper->escapeHtmlAttr(__('Created')) ?>"
                                        class="col date"><?= $escaper->escapeHtml($block->formatAlertDate((string)$alert->getAddDate())) ?>
                                    </td>
                                    <td data-th="<?= $escaper->escapeHtmlAttr(__('Product Name')) ?>" class="col item">
                                        <?php if ($product): ?>
                                            <strong class="product-name">
                                                <a href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>">
                                                    <?= $escaper->escapeHtml($product->getName()) ?>
                                                </a>
                                            </strong>
                                        <?php else: ?>
                                            <strong class="product-name">
                                                <?= $escaper->escapeHtml(__('Product #%1', $alert->getProductId())) ?>
                                            </strong>
                                        <?php endif; ?>
                                    </td>
                                    <td data-th="<?= $escaper->escapeHtmlAttr(__('Subscribed Price')) ?>" class="col price">
                                        <?= /* @noEscape */ $block->formatAlertPrice($alert->getPrice()) ?>
                                    </td>
                                    <td data-th="<?= $escaper->escapeHtmlAttr(__('Action')) ?>" class="col actions">
                                        <a href="<?= $escaper->escapeUrl(
                                            $block->getUnsubscribePriceUrl((int)$alert->getProductId())
                                        ) ?>"
                                           class="action delete"
                                           title="<?= $escaper->escapeHtmlAttr(__('Unsubscribe')) ?>">
                                            <span><?= $escaper->escapeHtml(__('Unsubscribe')) ?></span>
                                        </a>
                                    </td>
                                </tr>
                            <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                    <?php if ($block->getPricePagerHtml()): ?>
                        <div class="toolbar product-alerts-toolbar bottom">
                            <?= /* @noEscape */ $block->getPricePagerHtml() ?>
