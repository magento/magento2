<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My Product Alerts</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\ProductAlert\Block\Customer\ListAlerts"
                   name="productalert.customer.list"
                   template="Magento_ProductAlert::customer/list.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
