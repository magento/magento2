<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="StorefrontCustomerStockAlertSubscribeListUnsubscribeTest">
        <annotations>
            <features value="ProductAlert"/>
            <stories value="Customer product alerts account page"/>
            <title value="Customer can subscribe to stock alert, see it on My Product Alerts, and unsubscribe"/>
            <description value="Subscribe to stock alert from PDP, verify listing on combined page, unsubscribe"/>
            <severity value="MAJOR"/>
            <group value="product_alert"/>
        </annotations>
        <before>
            <createData entity="SimpleOutOfStockProduct" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <magentoCLI command="config:set catalog/productalert/allow_stock 1" stepKey="enableStockAlert"/>
            <magentoCLI command="config:set catalog/productalert/allow_price 0" stepKey="disablePriceAlert"/>
            <magentoCLI command="config:set cataloginventory/options/show_out_of_stock 1" stepKey="showOutOfStock"/>
            <actionGroup ref="CliCacheFlushActionGroup" stepKey="flushCache">
                <argument name="tags" value="config full_page"/>
            </actionGroup>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
        </before>
        <after>
            <magentoCLI command="config:set catalog/productalert/allow_stock 0" stepKey="restoreStockAlert"/>
            <magentoCLI command="config:set catalog/productalert/allow_price 0" stepKey="restorePriceAlert"/>
            <magentoCLI command="config:set cataloginventory/options/show_out_of_stock 0" stepKey="restoreShowOutOfStock"/>
            <actionGroup ref="CliCacheFlushActionGroup" stepKey="flushCacheAfter">
                <argument name="tags" value="config full_page"/>
            </actionGroup>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logout"/>
        </after>
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginToStorefront">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <actionGroup ref="StorefrontOpenProductPageActionGroup" stepKey="openProduct">
            <argument name="productUrl" value="$$createProduct.custom_attributes[url_key]$$"/>
        </actionGroup>
        <actionGroup ref="StorefrontSubscribeProductStockAlertActionGroup" stepKey="subscribeStock"/>
        <actionGroup ref="StorefrontOpenCustomerProductAlertsPageActionGroup" stepKey="openProductAlertsPage"/>
        <see selector="{{StorefrontCustomerProductAlertsSection.pageTitle}}" userInput="My Product Alerts" stepKey="seeTitle"/>
        <seeElement selector="{{StorefrontCustomerProductAlertsSection.stockAlertsTable}}" stepKey="seeStockTable"/>
        <see selector="{{StorefrontCustomerProductAlertsSection.productNameInStockTable}}" userInput="$$createProduct.name$$" stepKey="seeProductNameInList"/>
        <click selector="{{StorefrontCustomerProductAlertsSection.stockUnsubscribeButton}}" stepKey="clickUnsubscribe"/>
        <waitForPageLoad stepKey="waitAfterUnsub"/>
        <see userInput="You will no longer receive stock alerts for this product." stepKey="seeSuccessMessage"/>
        <actionGroup ref="StorefrontOpenCustomerProductAlertsPageActionGroup" stepKey="reopenProductAlertsPage"/>
        <dontSeeElement selector="{{StorefrontCustomerProductAlertsSection.stockAlertsTable}}" stepKey="tableGoneAfterUnsubscribe"/>
    </test>
</tests>
