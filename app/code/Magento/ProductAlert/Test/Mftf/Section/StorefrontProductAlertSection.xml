<sections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="urn:magento:mftf:Page/etc/SectionObject.xsd">
    <section name="StorefrontProductAlertSection">
        <element name="priceAlertLink" type="button" selector="//div[contains(@class,'product') and contains(@class,'alert') and contains(@class,'price')]//a[contains(@class,'alert')]"/>
        <element name="stockAlertLink" type="button" selector="//div[contains(@class,'product') and contains(@class,'alert') and contains(@class,'stock')]//a[contains(@class,'alert')]"/>
        <element name="successMessage" type="text" selector=".page.messages .message-success, .messages .message-success"/>
    </section>
</sections>
