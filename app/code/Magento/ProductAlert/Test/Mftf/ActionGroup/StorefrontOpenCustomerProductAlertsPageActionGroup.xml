<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontOpenCustomerProductAlertsPageActionGroup">
        <annotations>
            <description>Open the customer My Product Alerts page.</description>
        </annotations>
        <amOnPage url="{{StorefrontCustomerProductAlertsPage.url}}" stepKey="amOnProductAlertsPage"/>
        <waitForPageLoad stepKey="waitForProductAlertsPageLoad"/>
    </actionGroup>
</actionGroups>
