<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontUnsubscribeAllPriceAlertsActionGroup">
        <annotations>
            <description>Click "Unsubscribe from all price alerts" on My Product Alerts.</description>
        </annotations>
        <waitForElementVisible selector="{{StorefrontCustomerProductAlertsSection.priceUnsubscribeAllLink}}" stepKey="waitUnsubscribeAllPrice"/>
        <click selector="{{StorefrontCustomerProductAlertsSection.priceUnsubscribeAllLink}}" stepKey="clickUnsubscribeAllPrice"/>
        <waitForPageLoad stepKey="waitAfterUnsubscribeAllPrice"/>
    </actionGroup>
</actionGroups>
