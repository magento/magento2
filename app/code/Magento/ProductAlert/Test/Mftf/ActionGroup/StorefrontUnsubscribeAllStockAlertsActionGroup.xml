<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontUnsubscribeAllStockAlertsActionGroup">
        <annotations>
            <description>Click "Unsubscribe from all stock alerts" on My Product Alerts.</description>
        </annotations>
        <waitForElementVisible selector="{{StorefrontCustomerProductAlertsSection.stockUnsubscribeAllLink}}" stepKey="waitUnsubscribeAllStock"/>
        <click selector="{{StorefrontCustomerProductAlertsSection.stockUnsubscribeAllLink}}" stepKey="clickUnsubscribeAllStock"/>
        <waitForPageLoad stepKey="waitAfterUnsubscribeAllStock"/>
    </actionGroup>
</actionGroups>
