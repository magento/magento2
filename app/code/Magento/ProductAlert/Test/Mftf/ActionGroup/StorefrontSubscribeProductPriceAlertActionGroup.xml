<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontSubscribeProductPriceAlertActionGroup">
        <annotations>
            <description>Click "Notify me when the price drops" on the PDP.</description>
        </annotations>
        <waitForElementVisible selector="{{StorefrontProductAlertSection.priceAlertLink}}" stepKey="waitPriceAlertLink"/>
        <click selector="{{StorefrontProductAlertSection.priceAlertLink}}" stepKey="clickPriceAlertLink"/>
        <waitForPageLoad stepKey="waitAfterPriceSubscribe"/>
        <seeElement selector="{{StorefrontProductAlertSection.successMessage}}" stepKey="seeSubscribeSuccess"/>
    </actionGroup>
</actionGroups>
