<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontLoginToPayPalExpressCheckoutPayFlowEditionActionGroup">
        <annotations>
            <description>On Storefront Login To PayPal Express Checkout Payflow Edition .</description>
        </annotations>
        <arguments>
            <argument name="credentials" defaultValue="_CREDS"/>
        </arguments>
        <!--Check in-context-->
        <switchToNextTab stepKey="switchToInContentTab"/>
        <waitForPageLoad stepKey="waitForPayPalPageToLoad"/>
        <waitForElementClickable selector="{{PayPalPaymentSection.nextButton}}" stepKey="waitForNextButtonBeforeEmail" time="30"/>
        <waitForElementClickable selector="{{PayPalPaymentSection.email}}" stepKey="waitForEmailField" />
        <click selector="{{PayPalPaymentSection.email}}" stepKey="focusOnEmailField"/>
        <clearField selector="{{PayPalPaymentSection.email}}" stepKey="clearEmailField"/>
        <fillField selector="{{PayPalPaymentSection.email}}" userInput="{{credentials.magento/PAYPAL_LOGIN}}" stepKey="fillEmail"/>
        <waitForPageLoad stepKey="waitForNextPageLoad" time="30"/>
        <waitForElementClickable selector="{{PayPalPaymentSection.email}}" stepKey="waitForEmailFieldBeforeRefill"/>
        <click selector="{{PayPalPaymentSection.email}}" stepKey="refocusEmailField"/>
        <clearField selector="{{PayPalPaymentSection.email}}" stepKey="clearEmailFieldAgain"/>
        <fillField selector="{{PayPalPaymentSection.email}}" userInput="{{credentials.magento/PAYPAL_LOGIN}}" stepKey="refillEmail"/>
        <click selector="{{PayPalPaymentSection.nextButton}}" stepKey="clickNext"/>
        <waitForPageLoad stepKey="waitForNextPageLoadAgain" time="30"/>
        <conditionalClick selector="{{PayPalPaymentSection.nextButton}}" dependentSelector="{{PayPalPaymentSection.nextButton}}" visible="true" stepKey="clickNextAgainIfStillOnEmailStep"/>
        <waitForPageLoad stepKey="waitForPageLoadAfterRetryClick" time="30"/>
        <waitForElementNotVisible selector="{{PayPalPaymentSection.email}}" stepKey="waitForEmailStepToAdvance" time="60"/>
        <waitForElementVisible selector="{{PayPalPaymentSection.passwordOrUsePasswordButton}}" stepKey="waitForPasswordOrUsePasswordButtonToSettle"/>
        <conditionalClick selector="{{PayPalPaymentSection.usePasswordInsteadButton}}" dependentSelector="{{PayPalPaymentSection.password}}" visible="false" stepKey="clickUsePasswordInsteadIfPasswordFieldNotVisible"/>
        <waitForElementVisible selector="{{PayPalPaymentSection.password}}" stepKey="waitForPasswordFieldToBeVisible" />
        <fillField selector="{{PayPalPaymentSection.password}}" userInput="{{credentials.magento/PAYPAL_PWD}}" stepKey="fillPassword"/>
        <waitForElementClickable selector="{{PayPalPaymentSection.loginBtn}}" stepKey="waitForLoginField"/>
        <click selector="{{PayPalPaymentSection.loginBtn}}" stepKey="login"/>
        <waitForPageLoad stepKey="waitForDetailsPageToOpen"/>
    </actionGroup>
</actionGroups>
