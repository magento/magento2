<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="StorefrontCustomOptionOldPriceExcludingTaxTest">
        <annotations>
            <features value="Catalog"/>
            <stories value="Old price with catalog prices including tax and display excluding tax"/>
            <title value="Old price follows a custom option and stays excluding tax"/>
            <description value="Old price follows a custom option and stays excluding tax"/>
            <severity value="MAJOR"/>
            <group value="Catalog"/>
        </annotations>
        <before>
            <magentoCLI command="config:set tax/calculation/based_on origin" stepKey="setTaxBasedOnOrigin"/>
            <magentoCLI command="config:set tax/calculation/price_includes_tax 1" stepKey="setCatalogPricesIncludingTax"/>
            <magentoCLI command="config:set tax/display/type 1" stepKey="setDisplayExcludingTax"/>
            <createData entity="SimpleTaxRule" stepKey="createTaxRule"/>
            <createData entity="_defaultCategory" stepKey="createCategory"/>
            <createData entity="_defaultProduct" stepKey="createProduct">
                <requiredEntity createDataKey="createCategory"/>
                <field key="price">108.25</field>
            </createData>
            <createData entity="specialProductPrice2" stepKey="addSpecial">
                <requiredEntity createDataKey="createProduct"/>
                <field key="price">64.95</field>
            </createData>
            <updateData createDataKey="createProduct" entity="productWithCustomOptions" stepKey="addCustomOption"/>
            <actionGroup ref="CliIndexerReindexActionGroup" stepKey="reindex">
                <argument name="indices" value=""/>
            </actionGroup>
            <actionGroup ref="CliCacheCleanActionGroup" stepKey="cleanCache">
                <argument name="tags" value="config full_page"/>
            </actionGroup>
        </before>
        <after>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <deleteData createDataKey="createCategory" stepKey="deleteCategory"/>
            <deleteData createDataKey="createTaxRule" stepKey="deleteTaxRule"/>
            <magentoCLI command="config:set tax/calculation/based_on shipping" stepKey="resetTaxBasedOn"/>
            <magentoCLI command="config:set tax/calculation/price_includes_tax 0" stepKey="resetCatalogPrices"/>
            <magentoCLI command="config:set tax/display/type 1" stepKey="resetDisplay"/>
            <actionGroup ref="CliCacheCleanActionGroup" stepKey="cleanCacheAfter">
                <argument name="tags" value="config full_page"/>
            </actionGroup>
        </after>
        <actionGroup ref="StorefrontOpenProductPageActionGroup" stepKey="openProductPage">
            <argument name="productUrl" value="$$createProduct.custom_attributes[url_key]$$"/>
        </actionGroup>
        <grabTextFrom selector=".product-info-main .old-price .price" stepKey="grabOldOnLoad"/>
        <assertEquals stepKey="assertOldOnLoad">
            <actualResult type="const">$grabOldOnLoad</actualResult>
            <expectedResult type="string">$100.00</expectedResult>
        </assertEquals>
        <grabTextFrom selector=".product-info-main [data-price-type='basePrice'] .price" stepKey="grabFinalOnLoad"/>
        <assertEquals stepKey="assertFinalOnLoad">
            <actualResult type="const">$grabFinalOnLoad</actualResult>
            <expectedResult type="string">$60.00</expectedResult>
        </assertEquals>
        <selectOption selector="{{StorefrontProductPageSection.customOptionDropDown}}" userInput="{{ProductOptionValueDropdown3.title}} +$6.00" stepKey="selectCustomOption"/>
        <grabTextFrom selector=".product-info-main .old-price .price" stepKey="grabOldWithOption"/>
        <assertEquals stepKey="assertOldWithOption">
            <actualResult type="const">$grabOldWithOption</actualResult>
            <expectedResult type="string">$110.00</expectedResult>
        </assertEquals>
        <grabTextFrom selector=".product-info-main [data-price-type='basePrice'] .price" stepKey="grabFinalWithOption"/>
        <assertEquals stepKey="assertFinalWithOption">
            <actualResult type="const">$grabFinalWithOption</actualResult>
            <expectedResult type="string">$66.00</expectedResult>
        </assertEquals>
    </test>
</tests>
