<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontCustomerClickAccountConfirmationSendingLinkActionGroup">
        <annotations>
            <description>Clicks 'click here' in the account confirmation message, waits for the page.</description>
        </annotations>
        <waitForElementClickable selector="{{StorefrontCustomerMessagesSection.confirmLink}}"
                                 stepKey="waitForConfirmLink"/>
        <click selector="{{StorefrontCustomerMessagesSection.confirmLink}}" stepKey="clickHereLink"/>
        <waitForPageLoad stepKey="waitForConfirmationPageLoad"/>
        <seeInCurrentUrl url="{{StorefrontCustomerAccountConfirmationPage.url}}" stepKey="seeConfirmationPageUrl"/>
        <waitForElementVisible selector="{{StorefrontSendConfirmationLinkSection.emailField}}"
                               stepKey="waitForEmailField"/>
    </actionGroup>
</actionGroups>
