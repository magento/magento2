<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontVerifyOrderGridListActionGroup">
        <annotations>
            <description>Verify that the list of Orders is displayed in the grid</description>
        </annotations>
        <arguments>
            <argument name="pageNumber" type="string" defaultValue="2"/>
            <argument name="perPage" type="string" defaultValue="20"/>
            <argument name="expectedRowCount" type="string" defaultValue="15"/>
        </arguments>

        <seeElement selector="{{StorefrontCustomerOrderSection.isMyOrdersSection}}" stepKey="verifyOrderGridSeeMyOrdersSection"/>
        <scrollTo selector="{{StorefrontCustomerOrderSection.currentPage}}" stepKey="verifyOrderGridScrollToPager"/>
        <click selector="{{StorefrontCustomerOrderSection.pageNumber(pageNumber)}}" stepKey="verifyOrderGridGoToPage"/>
        <scrollTo selector="{{StorefrontCustomerOrderSection.perPage}}" stepKey="verifyOrderGridScrollToPerPage"/>
        <selectOption userInput="{{perPage}}" selector="{{StorefrontCustomerOrderSection.perPage}}" stepKey="verifyOrderGridSelectPerPage"/>
        <waitForPageLoad stepKey="verifyOrderGridWaitForPageLoad"/>
        <seeElement selector="{{StorefrontCustomerOrderSection.isMyOrdersSection}}" stepKey="verifyOrderGridSeeMyOrdersSectionAfterPaging"/>
        <dontSee selector="{{StorefrontOrderInformationMainSection.emptyMessage}}" userInput="You have placed no orders." stepKey="verifyOrderGridDontSeeEmptyMessage"/>
        <seeNumberOfElements selector="{{StorefrontCustomerOrderSection.rowsInColumn('id')}}" userInput="{{expectedRowCount}}" stepKey="verifyOrderGridSeeRowCount"/>
    </actionGroup>
</actionGroups>
