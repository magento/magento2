<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="AdminAssertProductImageDeleteUnusedHiddenActionGroup">
        <annotations>
            <description>
                Asserts Delete Unused Image Files checkbox is not visible (hidden and/or disabled).
            </description>
        </annotations>
        <waitForElementNotVisible selector="{{AdminImportMainSection.productImageDeleteUnused}}" time="30" stepKey="waitForDeleteUnusedNotVisible"/>
        <executeJS function="return (function () { var el = document.getElementById('product_image_delete_unused'); if (!el) { return '1'; } return (el.disabled || window.getComputedStyle(el).display === 'none' || window.getComputedStyle(el).visibility === 'hidden') ? '1' : '0'; })();" stepKey="deleteUnusedHiddenOrDisabled"/>
        <assertEquals stepKey="assertDeleteUnusedHiddenOrDisabled">
            <expectedResult type="string">1</expectedResult>
            <actualResult type="variable">deleteUnusedHiddenOrDisabled</actualResult>
        </assertEquals>
    </actionGroup>
</actionGroups>
