<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="StorefrontFillCaptchaFieldOnResetCustomerPasswordFormActionGroup">
        <annotations>
            <description>Fills the CAPTCHA field on the Storefront Forgot Password form.</description>
        </annotations>
        <arguments>
            <argument name="captcha" type="string"/>
        </arguments>
        <fillField userInput="{{captcha}}"
                   selector="{{StorefrontResetCustomerPasswordFormSection.captchaField}}"
                   stepKey="fillCaptchaField"/>
    </actionGroup>
</actionGroups>
